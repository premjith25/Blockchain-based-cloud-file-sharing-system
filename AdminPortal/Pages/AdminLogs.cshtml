@page
@model AdminLogsModel
@{
    ViewData["Title"] = "Activity Logs";
}
<h1>Activity Logs</h1>
<p><a asp-page="AdminHome">Back to admin home</a></p>
@if (Model.Logs.Count == 0)
{
    <p>No activity recorded yet.</p>
}
else
{
    <table border="1" cellpadding="6">
        <tr>
            <th>Log ID</th>
            <th>User</th>
            <th>File</th>
            <th>Action</th>
            <th>Time</th>
        </tr>
        @foreach (var l in Model.Logs)
        {
            <tr>
                <td>@l.LogId</td>
                <td>@l.UserName</td>
                <td>@l.FileName</td>
                <td>@l.Action</td>
                <td>@l.LoggedAt.ToString("dd MMM yyyy HH:mm:ss")</td>
            </tr>
        }
    </table>
}
